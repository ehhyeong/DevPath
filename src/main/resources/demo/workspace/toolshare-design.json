    "erdMermaid": "erDiagram\n    MEMBERS {\n        bigint id PK\n        varchar email\n        varchar nickname\n    }\n    TOOLS {\n        bigint id PK\n        bigint owner_id FK\n        varchar name\n        boolean available\n    }\n    LOANS {\n        bigint id PK\n        bigint tool_id FK\n        bigint borrower_id FK\n        date start_date\n        date end_date\n        varchar status\n    }\n    HANDOVERS {\n        bigint id PK\n        bigint loan_id FK\n        timestamp picked_up_at\n        timestamp returned_at\n    }\n    REVIEWS {\n        bigint id PK\n        bigint loan_id FK\n        bigint author_id FK\n        integer rating\n        varchar content\n    }\n    MEMBERS ||--o{ TOOLS : \"owner_id\"\n    TOOLS ||--o{ LOANS : \"tool_id\"\n    MEMBERS ||--o{ LOANS : \"borrower_id\"\n    LOANS ||--o{ HANDOVERS : \"loan_id\"\n    LOANS ||--o{ REVIEWS : \"loan_id\"\n    MEMBERS ||--o{ REVIEWS : \"author_id\"",
