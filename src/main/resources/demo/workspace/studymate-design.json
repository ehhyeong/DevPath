      "responseExample": "{\"studyId\":11}",
      "group": "스터디"
    },
    {
      "method": "GET",
      "path": "/api/studies",
      "description": "스터디 목록 조회",
      "auth": "MEMBER",
      "requestExample": "{}",
      "responseExample": "{\"studies\":[{\"studyId\":11,\"name\":\"퇴근 후 리액트\"}]}",
      "group": "스터디"
    },
