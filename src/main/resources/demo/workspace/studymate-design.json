{
  "title": "스터디 일정·출석 관리 플랫폼 (StudyMate)",
  "summary": "작은 스터디의 모임 일정과 참여 신청, 회차별 출석을 한곳에서 관리하고 참여 현황을 확인하는 서비스입니다.",
  "difficulty": "mvp",
  "stack": {
    "frontend": "React + TypeScript",
    "backend": "Spring Boot",
    "database": "PostgreSQL",
    "libraries": [
      "Spring Security",
      "Spring Data JPA",
      "React Query",
      "Tailwind CSS"
    ],
    "selectionReason": "React로 모임 달력과 출석 화면을 구성하고 Spring Boot의 참여자 권한 검증, PostgreSQL의 회차·회원 유일성 제약으로 중복 체크인을 방지합니다."
  },
  "scenario": {
    "userFlows": [
      {
        "actor": "방장",
        "action": "스터디를 만들고 참여 신청을 받아 모임 일정을 등록합니다."
      },
      {
        "actor": "참여자",
        "action": "관심 스터디에 가입하고 예정된 모임 시간에 출석을 체크합니다."
      },
      {
        "actor": "방장",
        "action": "회차별 출석 현황과 누적 참여율을 확인해 다음 모임을 준비합니다."
      }
    ],
    "coreFeatures": [
      "회원 인증과 스터디 방장·참여자 권한 관리",
      "스터디 개설과 참여 신청",
      "모임 일정 등록·조회와 출석 체크",
      "회차별 출석 현황과 참여율 조회"
    ]
  },
  "architecture": {
    "style": "Layered Architecture",
    "description": "Controller가 인증 사용자와 모임 ID를 받고 Service가 스터디 참여 여부·체크인 가능 시간·중복 출석 규칙을 검증합니다. Repository는 회차별 출석 조회와 참여율 집계를 담당합니다.",
    "components": [
      {
        "name": "React Web",
        "responsibility": "스터디 목록·모임 일정·체크인·출석 현황 화면"
      },
      {
        "name": "Spring Security",
        "responsibility": "인증 사용자 확인과 소유자·참여자 권한 검증"
      },
      {
        "name": "StudyMate API",
        "responsibility": "스터디 가입, 모임 관리, 출석 트랜잭션과 참여율 집계"
      },
      {
        "name": "PostgreSQL",
        "responsibility": "스터디·참여자·모임·출석 저장 및 중복 체크인 방지"
      }
    ],
    "erdMermaid": "erDiagram\n    MEMBERS ||--o{ STUDY_GROUPS : owns\n    MEMBERS ||--o{ STUDY_MEMBERS : joins\n    STUDY_GROUPS ||--o{ STUDY_MEMBERS : includes\n    STUDY_GROUPS ||--o{ SESSIONS : schedules\n    SESSIONS ||--o{ ATTENDANCES : records\n    MEMBERS ||--o{ ATTENDANCES : checks_in\n    MEMBERS {\n        bigint id PK\n        varchar email UK\n        varchar password_hash\n        varchar name\n    }\n    STUDY_GROUPS {\n        bigint id PK\n        bigint owner_id FK\n        varchar name\n        integer capacity\n    }\n    STUDY_MEMBERS {\n        bigint id PK\n        bigint study_id FK\n        bigint member_id FK\n        timestamp joined_at\n    }\n    SESSIONS {\n        bigint id PK\n        bigint study_id FK\n        varchar title\n        timestamp starts_at\n        timestamp ends_at\n    }\n    ATTENDANCES {\n        bigint id PK\n        bigint session_id FK\n        bigint member_id FK\n        timestamp checked_in_at\n    }",
    "entities": [
      {
        "name": "MEMBERS",
        "purpose": "인증 사용자",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "회원 ID"
          },
          {
            "name": "email",
            "type": "varchar(255)",
            "constraints": "UK, NOT NULL",
            "description": "로그인 이메일"
          },
          {
            "name": "password_hash",
            "type": "varchar(255)",
            "constraints": "NOT NULL",
            "description": "해시된 비밀번호"
          },
          {
            "name": "name",
            "type": "varchar(100)",
            "constraints": "NOT NULL",
            "description": "표시 이름"
          }
        ]
      },
      {
        "name": "STUDY_GROUPS",
        "purpose": "스터디 기본 정보와 방장",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "식별자"
          },
          {
            "name": "owner_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "방장 회원 ID"
          },
          {
            "name": "name",
            "type": "varchar(100)",
            "constraints": "NOT NULL",
            "description": "스터디 이름"
          },
          {
            "name": "capacity",
            "type": "integer",
            "constraints": "NOT NULL",
            "description": "최대 참여 인원"
          }
        ]
      },
      {
        "name": "STUDY_MEMBERS",
        "purpose": "스터디 참여 관계",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "식별자"
          },
          {
            "name": "study_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL, UK(study_id, member_id)",
            "description": "스터디 ID"
          },
          {
            "name": "member_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL, UK(study_id, member_id)",
            "description": "참여자 ID"
          },
          {
            "name": "joined_at",
            "type": "timestamp",
            "constraints": "NOT NULL",
            "description": "가입 시각"
          }
        ]
      },
      {
        "name": "SESSIONS",
        "purpose": "스터디 모임 일정",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "식별자"
          },
          {
            "name": "study_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "스터디 ID"
          },
          {
            "name": "title",
            "type": "varchar(100)",
            "constraints": "NOT NULL",
            "description": "모임 주제"
          },
          {
            "name": "starts_at",
            "type": "timestamp",
            "constraints": "NOT NULL",
            "description": "모임 시작 시각"
          },
          {
            "name": "ends_at",
            "type": "timestamp",
            "constraints": "NOT NULL",
            "description": "모임 종료 시각"
          }
        ]
      },
      {
        "name": "ATTENDANCES",
        "purpose": "회차별 출석 기록",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "식별자"
          },
          {
            "name": "session_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL, UK(session_id, member_id)",
            "description": "모임 ID"
          },
          {
            "name": "member_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL, UK(session_id, member_id)",
            "description": "출석 회원 ID"
          },
          {
            "name": "checked_in_at",
            "type": "timestamp",
            "constraints": "NOT NULL",
            "description": "체크인 시각"
          }
        ]
      }
    ],
    "technicalChallenges": [
      "비참여자가 모임 정보를 변경하거나 대신 출석할 수 없도록 권한을 검증합니다.",
      "회차·회원 UNIQUE 제약으로 동시에 들어온 체크인을 한 건으로 처리합니다.",
      "모임 시작·종료 시각과 사용자 시간대를 구분해 출석 가능 시간을 판단합니다."
    ]
  },
  "apis": [
    {
      "group": "AUTH (인증)",
      "method": "POST",
      "path": "/api/auth/signup",
      "description": "회원가입",
      "auth": "없음",
      "requestExample": "{\"email\":\"demo@example.com\",\"password\":\"example-password\",\"name\":\"사용자\"}",
      "responseExample": "{\"memberId\":1}"
    },
    {
      "group": "AUTH (인증)",
      "method": "POST",
      "path": "/api/auth/login",
      "description": "로그인",
      "auth": "없음",
      "requestExample": "{\"email\":\"demo@example.com\",\"password\":\"example-password\"}",
      "responseExample": "{\"accessToken\":\"example-token\"}"
    },
    {
      "method": "POST",
      "path": "/api/studies",
      "description": "스터디 개설",
