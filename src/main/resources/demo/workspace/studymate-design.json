      "requestExample": "{\"title\":\"렌더링 이해하기\",\"startsAt\":\"2026-11-03T20:00:00+09:00\",\"endsAt\":\"2026-11-03T21:00:00+09:00\"}",
      "responseExample": "{\"sessionId\":21}",
      "group": "일정"
    },
    {
      "method": "GET",
      "path": "/api/studies/{studyId}/sessions",
      "description": "참여 스터디의 모임 목록",
      "auth": "MEMBER",
      "requestExample": "{}",
      "responseExample": "{\"sessions\":[{\"sessionId\":21,\"title\":\"렌더링 이해하기\"}]}",
      "group": "일정"
    },
    {
      "method": "PUT",
      "path": "/api/sessions/{sessionId}/attendance",
      "description": "인증 참여자 출석 체크",
