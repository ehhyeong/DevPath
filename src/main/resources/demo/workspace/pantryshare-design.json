{
  "title": "동네 공유 물품 나눔 플랫폼 (PantryShare)",
  "summary": "이웃이 남는 생활 물품을 등록하고 수량을 예약한 뒤 정해진 시간에 전달을 확인하는 소규모 나눔 서비스입니다.",
  "difficulty": "mvp",
  "stack": {
    "frontend": "Vue 3 + TypeScript",
    "backend": "Spring Boot",
    "database": "PostgreSQL",
    "libraries": [
      "Pinia",
      "TanStack Vue Query",
      "Spring Security",
      "Spring Data JPA"
    ],
    "selectionReason": "Vue로 목록·예약 상태 화면을 구성하고 Spring Boot 트랜잭션과 PostgreSQL의 조건부 갱신으로 나눔 수량의 초과 예약을 방지합니다."
  },
  "scenario": {
    "userFlows": [
      {
        "actor": "나눔자",
        "action": "물품과 수량, 받을 수 있는 시간을 등록해 나눔 글을 공개합니다."
      },
      {
        "actor": "이웃",
        "action": "남은 수량과 수령 시간을 확인하고 필요한 수량을 예약합니다."
      },
      {
        "actor": "나눔자",
        "action": "약속한 이웃에게 물품을 전달하고 완료를 기록합니다."
      }
    ],
    "coreFeatures": [
      "회원 인증과 나눔자·예약자 접근 제어",
      "물품과 나눔 수량·수령 기한 등록",
      "남은 수량을 보장하는 예약·취소",
      "전달 완료와 내 예약 현황 조회"
    ]
  },
  "architecture": {
    "style": "Layered Architecture",
    "description": "Controller가 인증 사용자와 예약 수량을 받고 Service가 게시 상태·수령 기한·가용 수량을 검증합니다. 예약 생성과 수량 차감은 하나의 트랜잭션으로 처리하고 Repository는 잠금 조회와 상태별 목록을 제공합니다.",
    "components": [
      {
        "name": "Vue 3 + TypeScript",
        "responsibility": "나눔 목록·물품 등록·예약과 전달 확인 화면"
      },
      {
        "name": "Spring Security",
        "responsibility": "인증 사용자 확인과 소유자·참여자 권한 검증"
      },
      {
        "name": "PantryShare API",
        "responsibility": "나눔 공개, 수량 예약·복원, 전달 상태 전이"
      },
      {
        "name": "PostgreSQL",
        "responsibility": "물품·나눔·예약·전달 이력 저장과 가용 수량 보장"
      }
    ],
    "erdMermaid": "erDiagram\n    MEMBERS ||--o{ ITEMS : owns\n    ITEMS ||--o{ OFFERS : offers\n    OFFERS ||--o{ RESERVATIONS : reserves\n    MEMBERS ||--o{ RESERVATIONS : requests\n    RESERVATIONS ||--o| HANDOVERS : completes\n    MEMBERS ||--o{ HANDOVERS : confirms\n    MEMBERS {\n        bigint id PK\n        varchar email UK\n        varchar password_hash\n        varchar name\n    }\n    ITEMS {\n        bigint id PK\n        bigint owner_id FK\n        varchar name\n        text description\n    }\n    OFFERS {\n        bigint id PK\n        bigint item_id FK\n        integer remaining_quantity\n        timestamp pickup_until\n        varchar status\n    }\n    RESERVATIONS {\n        bigint id PK\n        bigint offer_id FK\n        bigint member_id FK\n        integer quantity\n        varchar status\n    }\n    HANDOVERS {\n        bigint id PK\n        bigint reservation_id FK\n        bigint confirmed_by FK\n        timestamp completed_at\n    }",
    "entities": [
      {
        "name": "MEMBERS",
        "purpose": "인증 사용자",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "회원 ID"
          },
          {
            "name": "email",
            "type": "varchar(255)",
            "constraints": "UK, NOT NULL",
            "description": "로그인 이메일"
          },
          {
            "name": "password_hash",
            "type": "varchar(255)",
            "constraints": "NOT NULL",
            "description": "해시된 비밀번호"
          },
          {
            "name": "name",
            "type": "varchar(100)",
            "constraints": "NOT NULL",
            "description": "표시 이름"
          }
        ]
      },
      {
        "name": "ITEMS",
        "purpose": "나눔할 물품 정보",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "식별자"
          },
          {
            "name": "owner_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "물품 소유자"
          },
          {
            "name": "name",
            "type": "varchar(100)",
            "constraints": "NOT NULL",
            "description": "물품 이름"
          },
          {
            "name": "description",
            "type": "text",
            "constraints": "NOT NULL",
            "description": "물품 상태와 안내"
          }
        ]
      },
      {
        "name": "OFFERS",
        "purpose": "공개 나눔과 가용 수량",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "식별자"
          },
          {
            "name": "item_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "나눔 물품"
          },
          {
            "name": "remaining_quantity",
            "type": "integer",
            "constraints": "NOT NULL, CHECK >= 0",
            "description": "남은 수량"
          },
          {
            "name": "pickup_until",
            "type": "timestamp",
            "constraints": "NOT NULL",
            "description": "수령 기한"
          },
          {
            "name": "status",
            "type": "varchar(20)",
            "constraints": "NOT NULL",
            "description": "OPEN 또는 CLOSED"
          }
        ]
      },
      {
        "name": "RESERVATIONS",
        "purpose": "이웃의 수령 예약",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "식별자"
          },
          {
            "name": "offer_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "예약한 나눔"
          },
          {
            "name": "member_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "예약자"
          },
          {
            "name": "quantity",
            "type": "integer",
            "constraints": "NOT NULL, CHECK > 0",
            "description": "예약 수량"
          },
          {
            "name": "status",
            "type": "varchar(20)",
            "constraints": "NOT NULL",
            "description": "RESERVED, CANCELLED, COMPLETED"
          }
        ]
      },
      {
        "name": "HANDOVERS",
        "purpose": "물품 전달 완료 이력",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "식별자"
          },
          {
            "name": "reservation_id",
            "type": "bigint",
            "constraints": "FK, UK, NOT NULL",
            "description": "전달한 예약"
          },
          {
            "name": "confirmed_by",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "확인한 나눔자"
          },
          {
            "name": "completed_at",
            "type": "timestamp",
            "constraints": "NOT NULL",
            "description": "전달 완료 시각"
          }
        ]
      }
    ],
    "technicalChallenges": [
      "동시 예약에서도 남은 수량이 음수가 되지 않도록 잠금이나 조건부 갱신을 적용합니다.",
      "예약 취소와 수량 복원을 같은 트랜잭션에 묶고 중복 취소를 막습니다.",
      "소유자만 전달을 확인하고 수령 기한이 지난 나눔에는 예약을 받지 않습니다."
    ]
  },
  "apis": [
    {
      "group": "AUTH (인증)",
      "method": "POST",
      "path": "/api/auth/signup",
      "description": "회원가입",
      "auth": "없음",
      "requestExample": "{\"email\":\"demo@example.com\",\"password\":\"example-password\",\"name\":\"사용자\"}",
      "responseExample": "{\"memberId\":1}"
    },
    {
      "group": "AUTH (인증)",
      "method": "POST",
      "path": "/api/auth/login",
      "description": "로그인",
      "auth": "없음",
      "requestExample": "{\"email\":\"demo@example.com\",\"password\":\"example-password\"}",
      "responseExample": "{\"accessToken\":\"example-token\"}"
    },
    {
      "method": "POST",
      "path": "/api/items",
      "description": "내 물품 등록",
      "auth": "MEMBER",
      "requestExample": "{\"name\":\"미사용 머그컵\",\"description\":\"포장된 새 제품 2개\"}",
      "responseExample": "{\"itemId\":31}",
      "group": "물품"
    },
    {
      "method": "POST",
      "path": "/api/offers",
      "description": "나눔 공개",
      "auth": "MEMBER",
      "requestExample": "{\"itemId\":31,\"quantity\":2,\"pickupUntil\":\"2026-11-05T19:00:00+09:00\"}",
      "responseExample": "{\"offerId\":41,\"remainingQuantity\":2}",
      "group": "나눔"
    },
    {
      "method": "GET",
      "path": "/api/offers",
      "description": "예약 가능한 나눔 목록",
      "auth": "MEMBER",
      "requestExample": "{}",
      "responseExample": "{\"offers\":[{\"offerId\":41,\"remainingQuantity\":2}]}",
      "group": "나눔"
    },
    {
      "method": "POST",
      "path": "/api/offers/{offerId}/reservations",
      "description": "가용 수량 내 예약",
      "auth": "MEMBER",
      "requestExample": "{\"quantity\":1}",
      "responseExample": "{\"reservationId\":51,\"status\":\"RESERVED\"}",
      "group": "예약"
    },
    {
      "method": "GET",
      "path": "/api/reservations",
      "description": "내 예약 현황",
      "auth": "MEMBER",
      "requestExample": "{}",
      "responseExample": "{\"reservations\":[{\"reservationId\":51,\"status\":\"RESERVED\"}]}",
      "group": "예약"
    },
    {
      "method": "POST",
      "path": "/api/reservations/{reservationId}/cancel",
      "description": "내 예약 취소와 수량 복원",
      "auth": "MEMBER",
      "requestExample": "{}",
      "responseExample": "{\"reservationId\":51,\"status\":\"CANCELLED\"}",
      "group": "예약"
    },
    {
      "method": "POST",
      "path": "/api/reservations/{reservationId}/handover",
      "description": "나눔자 전달 완료 확인",
      "auth": "MEMBER",
      "requestExample": "{}",
      "responseExample": "{\"reservationId\":51,\"status\":\"COMPLETED\"}",
      "group": "전달"
    }
  ],
