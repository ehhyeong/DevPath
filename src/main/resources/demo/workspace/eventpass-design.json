          },
          {
            "name": "nickname",
            "type": "varchar(120)",
            "constraints": "NOT NULL",
            "description": "표시 이름"
          }
        ]
      },
      {
        "name": "EVENTS",
        "purpose": "행사 정보와 좌석 수량",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "고유 ID"
          },
          {
            "name": "host_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "행사 주최자"
          },
          {
            "name": "title",
            "type": "varchar(120)",
            "constraints": "NOT NULL",
            "description": "행사 이름"
          },
          {
            "name": "starts_at",
