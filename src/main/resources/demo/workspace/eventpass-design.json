            "constraints": "NOT NULL",
            "description": "시작 시각"
          },
          {
            "name": "remaining_seats",
            "type": "integer",
            "constraints": "NOT NULL",
            "description": "남은 좌석"
          }
        ]
      },
      {
        "name": "RESERVATIONS",
        "purpose": "행사별 좌석 예약",
