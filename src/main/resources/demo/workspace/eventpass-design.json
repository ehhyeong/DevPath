  "architecture": {
    "style": "모놀리식 3계층",
    "description": "React 웹 클라이언트가 인증된 REST API를 호출하고 서비스 계층의 트랜잭션에서 EventPass 데이터를 저장합니다.",
    "components": [
      {
        "name": "React Web",
        "responsibility": "행사 등록과 잔여 좌석 조회 · 행사별 좌석 예약과 취소 · 모바일 입장 티켓 발급 · 주최자 티켓 검증과 중복 입장 방지 · 입장 현황과 마감 상태 관리"
      },
      {
        "name": "Spring Boot API",
        "responsibility": "예약 인원은 양수이고 잔여 좌석을 넘지 않아야 하며 취소되거나 이미 사용된 티켓은 입장할 수 없습니다."
      },
      {
        "name": "PostgreSQL",
        "responsibility": "마지막 좌석의 동시 예약을 원자적으로 처리하고 같은 티켓을 한 번만 입장 처리합니다."
      }
    ],
    "erdMermaid": "erDiagram\n    MEMBERS {\n        bigint id PK\n        varchar email\n        varchar nickname\n    }\n    EVENTS {\n        bigint id PK\n        bigint host_id FK\n        varchar title\n        timestamp starts_at\n        integer remaining_seats\n    }\n    RESERVATIONS {\n        bigint id PK\n        bigint event_id FK\n        bigint member_id FK\n        integer quantity\n        varchar status\n    }\n    TICKETS {\n        bigint id PK\n        bigint reservation_id FK\n        varchar code\n        timestamp used_at\n    }\n    CHECK_INS {\n        bigint id PK\n        bigint ticket_id FK\n        bigint operator_id FK\n        timestamp checked_at\n    }\n    MEMBERS ||--o{ EVENTS : \"host_id\"\n    EVENTS ||--o{ RESERVATIONS : \"event_id\"\n    MEMBERS ||--o{ RESERVATIONS : \"member_id\"\n    RESERVATIONS ||--o{ TICKETS : \"reservation_id\"\n    TICKETS ||--o{ CHECK_INS : \"ticket_id\"\n    MEMBERS ||--o{ CHECK_INS : \"operator_id\"",
    "entities": [
