            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "고유 ID"
          },
          {
            "name": "ticket_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "검증한 티켓"
