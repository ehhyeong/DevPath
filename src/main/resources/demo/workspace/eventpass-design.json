    {
      "group": "TICKETS (입장)",
      "method": "POST",
      "path": "/api/tickets/{ticketId}/check-in",
      "description": "티켓 입장 확인",
      "auth": "USER",
      "requestExample": "{\"code\":\"ticket-example\"}",
      "responseExample": "{\"status\":\"CHECKED_IN\"}"
    },
    {
      "group": "RESERVATIONS (예약)",
      "method": "DELETE",
      "path": "/api/reservations/{reservationId}",
      "description": "예약 취소",
      "auth": "USER",
      "requestExample": "{}",
      "responseExample": "{\"status\":\"CANCELLED\"}"
    },
    {
      "group": "EVENTS (행사)",
      "method": "GET",
      "path": "/api/events/{eventId}/capacity",
      "description": "행사 잔여 좌석",
      "auth": "USER",
      "requestExample": "{}",
      "responseExample": "{\"remainingSeats\":28}"
    }
