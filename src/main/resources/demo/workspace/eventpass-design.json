          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "고유 ID"
          },
          {
            "name": "event_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "예약 행사"
          },
          {
            "name": "member_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "예약 회원"
          },
          {
            "name": "quantity",
            "type": "integer",
            "constraints": "NOT NULL",
            "description": "예약 좌석 수"
          },
          {
            "name": "status",
            "type": "varchar(120)",
            "constraints": "NOT NULL",
            "description": "CONFIRMED/CANCELLED"
          }
        ]
      },
      {
        "name": "TICKETS",
        "purpose": "예약에서 발급한 입장 티켓",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "고유 ID"
          },
          {
            "name": "reservation_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "연결 예약"
          },
          {
            "name": "code",
            "type": "varchar(120)",
            "constraints": "NOT NULL",
            "description": "일회용 티켓 코드"
          },
          {
            "name": "used_at",
            "type": "timestamp",
            "constraints": "",
            "description": "최초 입장 시각"
          }
        ]
      },
      {
        "name": "CHECK_INS",
        "purpose": "주최자의 티켓 검증 이력",
        "columns": [
