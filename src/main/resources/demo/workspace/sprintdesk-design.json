{
  "title": "팀 스프린트·이슈 관리 보드 (SprintDesk)",
  "summary": "작은 개발팀이 스프린트 목표와 담당 이슈를 정하고 보드에서 진행 상태를 공유하는 협업 서비스입니다.",
  "difficulty": "mvp",
  "stack": {
    "frontend": "React + TypeScript",
    "backend": "Spring Boot",
    "database": "PostgreSQL",
    "libraries": [
      "Spring Security",
      "Spring Data JPA",
      "React Query",
      "dnd-kit"
    ],
    "selectionReason": "React와 dnd-kit으로 상태 보드를 구현하고 Spring Boot의 프로젝트 권한 검증 및 PostgreSQL의 버전 컬럼으로 여러 팀원의 동시 수정을 다룹니다."
  },
  "scenario": {
    "userFlows": [
      {
        "actor": "팀장",
        "action": "프로젝트를 만들고 팀원을 초대해 스프린트 목표를 정합니다."
      },
      {
        "actor": "팀원",
        "action": "담당 이슈를 등록하고 보드에서 진행 상태를 변경합니다."
      },
      {
        "actor": "팀장",
        "action": "스프린트별 미완료 이슈와 담당자를 확인해 다음 계획을 조정합니다."
      }
    ],
    "coreFeatures": [
      "회원 인증과 프로젝트 팀장·팀원 권한 관리",
      "프로젝트 개설과 팀원 초대",
      "기간과 목표를 가진 스프린트 생성",
      "담당 이슈 등록·조회와 상태 보드 갱신"
    ]
  },
  "architecture": {
    "style": "Layered Architecture",
    "description": "Controller가 인증 사용자와 변경 요청을 받고 Service가 프로젝트 참여·스프린트 상태·허용된 이슈 상태 전이를 검증합니다. Repository는 프로젝트·스프린트별 조회와 버전 기반 동시 수정 감지를 담당합니다.",
    "components": [
      {
        "name": "React Web",
        "responsibility": "프로젝트 목록·스프린트 계획·이슈 보드와 담당자 필터"
      },
      {
        "name": "Spring Security",
        "responsibility": "인증 사용자 확인과 소유자·참여자 권한 검증"
      },
      {
        "name": "SprintDesk API",
        "responsibility": "팀원 초대, 스프린트 생성, 이슈 할당과 상태 전이"
      },
      {
        "name": "PostgreSQL",
        "responsibility": "프로젝트·참여자·스프린트·이슈 및 동시 수정 버전 저장"
      }
    ],
    "erdMermaid": "erDiagram\n    MEMBERS ||--o{ PROJECTS : owns\n    PROJECTS ||--o{ PROJECT_MEMBERS : includes\n    MEMBERS ||--o{ PROJECT_MEMBERS : joins\n    PROJECTS ||--o{ SPRINTS : plans\n    SPRINTS ||--o{ ISSUES : contains\n    MEMBERS ||--o{ ISSUES : assigned\n    MEMBERS {\n        bigint id PK\n        varchar email UK\n        varchar password_hash\n        varchar name\n    }\n    PROJECTS {\n        bigint id PK\n        bigint owner_id FK\n        varchar name\n        text description\n    }\n    PROJECT_MEMBERS {\n        bigint id PK\n        bigint project_id FK\n        bigint member_id FK\n        varchar role\n    }\n    SPRINTS {\n        bigint id PK\n        bigint project_id FK\n        varchar goal\n        date starts_on\n        date ends_on\n        varchar status\n    }\n    ISSUES {\n        bigint id PK\n        bigint sprint_id FK\n        bigint assignee_id FK\n        varchar title\n        varchar status\n        bigint version\n    }",
    "entities": [
      {
        "name": "MEMBERS",
        "purpose": "인증 사용자",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "회원 ID"
          },
          {
            "name": "email",
            "type": "varchar(255)",
            "constraints": "UK, NOT NULL",
            "description": "로그인 이메일"
          },
          {
            "name": "password_hash",
            "type": "varchar(255)",
            "constraints": "NOT NULL",
            "description": "해시된 비밀번호"
          },
          {
            "name": "name",
            "type": "varchar(100)",
            "constraints": "NOT NULL",
            "description": "표시 이름"
          }
        ]
      },
      {
        "name": "PROJECTS",
        "purpose": "팀 프로젝트",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "식별자"
          },
          {
            "name": "owner_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "팀장 회원 ID"
          },
          {
            "name": "name",
            "type": "varchar(100)",
            "constraints": "NOT NULL",
            "description": "프로젝트 이름"
          },
          {
            "name": "description",
            "type": "text",
            "constraints": "NOT NULL",
            "description": "프로젝트 목표"
          }
        ]
      },
      {
        "name": "PROJECT_MEMBERS",
        "purpose": "프로젝트 참여 관계",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "식별자"
          },
          {
            "name": "project_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL, UK(project_id, member_id)",
            "description": "프로젝트 ID"
          },
          {
            "name": "member_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL, UK(project_id, member_id)",
            "description": "팀원 ID"
          },
          {
            "name": "role",
            "type": "varchar(20)",
            "constraints": "NOT NULL",
            "description": "LEADER 또는 MEMBER"
          }
        ]
      },
      {
        "name": "SPRINTS",
        "purpose": "기간과 목표가 있는 스프린트",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "식별자"
          },
          {
            "name": "project_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "프로젝트 ID"
          },
          {
            "name": "goal",
            "type": "varchar(255)",
            "constraints": "NOT NULL",
            "description": "스프린트 목표"
          },
          {
            "name": "starts_on",
            "type": "date",
            "constraints": "NOT NULL",
            "description": "시작 날짜"
          },
          {
            "name": "ends_on",
            "type": "date",
            "constraints": "NOT NULL",
            "description": "종료 날짜"
          },
          {
            "name": "status",
            "type": "varchar(20)",
            "constraints": "NOT NULL",
            "description": "PLANNED, ACTIVE, CLOSED"
          }
        ]
      },
      {
        "name": "ISSUES",
        "purpose": "담당 이슈와 진행 상태",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "constraints": "PK",
            "description": "식별자"
          },
          {
            "name": "sprint_id",
            "type": "bigint",
            "constraints": "FK, NOT NULL",
            "description": "스프린트 ID"
          },
          {
            "name": "assignee_id",
            "type": "bigint",
            "constraints": "FK",
            "description": "담당 팀원 ID"
          },
          {
            "name": "title",
            "type": "varchar(150)",
            "constraints": "NOT NULL",
            "description": "작업 제목"
          },
          {
            "name": "status",
            "type": "varchar(20)",
            "constraints": "NOT NULL",
            "description": "TODO, IN_PROGRESS, DONE"
          },
          {
            "name": "version",
            "type": "bigint",
            "constraints": "NOT NULL",
            "description": "낙관적 잠금 버전"
          }
        ]
      }
    ],
    "technicalChallenges": [
      "프로젝트 비참여자의 이슈 변경과 다른 프로젝트 담당자 지정을 차단합니다.",
      "이슈 버전으로 동시 수정을 감지하고 충돌 시 최신 상태를 안내합니다.",
      "종료된 스프린트의 변경 제한과 허용된 상태 전이를 일관되게 적용합니다."
    ]
  },
  "apis": [
    {
      "group": "AUTH (인증)",
      "method": "POST",
      "path": "/api/auth/signup",
      "description": "회원가입",
      "auth": "없음",
      "requestExample": "{\"email\":\"demo@example.com\",\"password\":\"example-password\",\"name\":\"사용자\"}",
      "responseExample": "{\"memberId\":1}"
    },
    {
      "group": "AUTH (인증)",
      "method": "POST",
      "path": "/api/auth/login",
      "description": "로그인",
      "auth": "없음",
      "requestExample": "{\"email\":\"demo@example.com\",\"password\":\"example-password\"}",
      "responseExample": "{\"accessToken\":\"example-token\"}"
    },
    {
      "method": "POST",
      "path": "/api/projects",
      "description": "팀 프로젝트 생성",
      "auth": "MEMBER",
      "requestExample": "{\"name\":\"포트폴리오 빌더\",\"description\":\"문서 편집 MVP\"}",
      "responseExample": "{\"projectId\":61}",
      "group": "프로젝트"
    },
    {
      "method": "GET",
      "path": "/api/projects",
      "description": "내 프로젝트 목록",
      "auth": "MEMBER",
      "requestExample": "{}",
      "responseExample": "{\"projects\":[{\"projectId\":61,\"name\":\"포트폴리오 빌더\"}]}",
      "group": "프로젝트"
    },
    {
      "method": "POST",
      "path": "/api/projects/{projectId}/members",
      "description": "팀장 팀원 초대",
      "auth": "MEMBER",
      "requestExample": "{\"email\":\"teammate@example.com\"}",
      "responseExample": "{\"memberId\":8,\"role\":\"MEMBER\"}",
      "group": "팀원"
    },
    {
      "method": "POST",
      "path": "/api/projects/{projectId}/sprints",
      "description": "스프린트 생성",
      "auth": "MEMBER",
      "requestExample": "{\"goal\":\"편집부터 PDF 출력까지\",\"startsOn\":\"2026-11-02\",\"endsOn\":\"2026-11-13\"}",
      "responseExample": "{\"sprintId\":71,\"status\":\"ACTIVE\"}",
      "group": "스프린트"
    },
    {
      "method": "GET",
      "path": "/api/sprints/{sprintId}/issues",
      "description": "스프린트 이슈 목록",
      "auth": "MEMBER",
      "requestExample": "{}",
      "responseExample": "{\"issues\":[{\"issueId\":81,\"title\":\"PDF 미리보기\",\"status\":\"TODO\",\"version\":0}]}",
      "group": "이슈"
    },
    {
      "method": "POST",
      "path": "/api/sprints/{sprintId}/issues",
      "description": "팀원 이슈 등록",
      "auth": "MEMBER",
      "requestExample": "{\"title\":\"PDF 미리보기\",\"assigneeId\":8}",
      "responseExample": "{\"issueId\":81,\"status\":\"TODO\",\"version\":0}",
      "group": "이슈"
    },
    {
      "method": "PATCH",
      "path": "/api/issues/{issueId}/status",
      "description": "참여자 이슈 상태 변경",
      "auth": "MEMBER",
      "requestExample": "{\"status\":\"IN_PROGRESS\",\"version\":0}",
      "responseExample": "{\"issueId\":81,\"status\":\"IN_PROGRESS\",\"version\":1}",
      "group": "이슈"
    }
  ],
