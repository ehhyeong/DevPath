    "erdMermaid": "erDiagram\n    MEMBERS {\n        bigint id PK\n        varchar email\n        varchar nickname\n    }\n    TRIPS {\n        bigint id PK\n        bigint owner_id FK\n        varchar title\n        varchar currency\n    }\n    TRIP_MEMBERS {\n        bigint id PK\n        bigint trip_id FK\n        bigint member_id FK\n        varchar role\n    }\n    EXPENSES {\n        bigint id PK\n        bigint trip_id FK\n        bigint payer_id FK\n        decimal amount\n        varchar memo\n    }\n    EXPENSE_SHARES {\n        bigint id PK\n        bigint expense_id FK\n        bigint member_id FK\n        decimal share_amount\n    }\n    MEMBERS ||--o{ TRIPS : \"owner_id\"\n    TRIPS ||--o{ TRIP_MEMBERS : \"trip_id\"\n    MEMBERS ||--o{ TRIP_MEMBERS : \"member_id\"\n    TRIPS ||--o{ EXPENSES : \"trip_id\"\n    MEMBERS ||--o{ EXPENSES : \"payer_id\"\n    EXPENSES ||--o{ EXPENSE_SHARES : \"expense_id\"\n    MEMBERS ||--o{ EXPENSE_SHARES : \"member_id\"",
